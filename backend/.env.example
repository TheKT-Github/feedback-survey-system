# ========================================================
# Style Feedback Intelligence AI — Environment Template
# ========================================================
# Copy this file to .env and configure values for your environment.
# NEVER commit the actual .env file with secrets to version control.

# Server Configuration
PORT=3000
MONGO_URI=mongodb://localhost:27017/feedbackDB
JWT_SECRET=your_jwt_secret_key_minimum_16_characters_in_production

# CORS Configuration
# Comma-separated list of approved frontend origins.
# (Local development defaults: http://localhost:3000, http://127.0.0.1:3000, http://localhost:5500, http://127.0.0.1:5500)
# ALLOWED_ORIGINS=https://stylesense.yourdomain.com,https://admin.yourdomain.com

# Reverse Proxy Trust Configuration
# Set to '1' or 'true' if deployed behind a trusted reverse proxy (e.g. Nginx, Cloudflare, AWS ALB)
# Leaves untrusted (false) by default for local development to prevent IP header spoofing.
# TRUST_PROXY=1

# Optional Rate Limiter Configuration (requests per 15-minute window)
# AUTH_RATE_LIMIT_MAX=20
# REGISTER_RATE_LIMIT_MAX=15
# FEEDBACK_RATE_LIMIT_MAX=100
# SURVEY_RATE_LIMIT_MAX=30
# AI_RATE_LIMIT_MAX=30

# Initial Admin Credentials (used during database seeding)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_admin_password_in_production

# LLM Configuration (Phase 9 — Style Feedback Intelligence AI)
# Supported LLM_PROVIDER options: 'gemini' | 'openai'
LLM_PROVIDER=gemini

# Your LLM Provider API Key (Keep confidential, never commit)
# NOTICE: Model API usage may incur costs per your provider's pricing plan.
LLM_API_KEY=YOUR_ACTUAL_KEY

# Model name:
# - Gemini examples: gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro
# - OpenAI examples: gpt-4o-mini, gpt-4o
LLM_MODEL=gemini-1.5-flash

# Base URL (Must be a trusted HTTPS endpoint):
# - Gemini default: https://generativelanguage.googleapis.com
# - OpenAI default: https://api.openai.com
LLM_BASE_URL=https://generativelanguage.googleapis.com

# Optional: Comma-separated list of additional trusted HTTPS domains for LLM_BASE_URL
# LLM_ALLOWED_HOSTS=custom-ai-gateway.company.com

# Request Timeout in milliseconds (default: 15000ms / 15 seconds)
LLM_TIMEOUT_MS=15000

# Maximum output tokens generated by the model
LLM_MAX_TOKENS=1000

# Generation temperature (0.0 to 1.0; low value like 0.2 recommended for factual feedback analysis)
LLM_TEMPERATURE=0.2

# -------------------------------------------------------------------------
# AI Demo Mode & Caching (Phase 12+ stabilization)
# -------------------------------------------------------------------------

# AI Demo Mode — set to 'true' to serve pre-seeded sample AI responses instead of calling Gemini.
# Use ONLY during local demonstrations when the Gemini API quota is exhausted.
# IMPORTANT: Demo mode is AUTOMATICALLY DISABLED when NODE_ENV=production, regardless of this setting.
# Default: false (live Gemini calls)
AI_DEMO_MODE=false

# AI Cache TTL — time-to-live for in-memory AI response cache in milliseconds.
# Cached responses are automatically invalidated when new feedback is submitted.
# Default: 900000 (15 minutes)
AI_CACHE_TTL_MS=900000
